      "id": "CWE-352",
      "name": "Browser HTTP Basic authentication with disabled CSRF protection",
      "status": "FOUND",
      "evidence": {
        "files": [
          "src/main/java/com/photoalbum/config/SecurityConfig.java:48-58",
          "src/main/java/com/photoalbum/controller/DetailController.java:64-65"
        ],
        "explanation": "CSRF is disabled while state-changing POST routes accept HTTP Basic authentication. A browser can automatically resend cached Basic credentials; stateless session configuration does not itself prevent CSRF. Cross-origin form submission to a known photo deletion URL can therefore act with an already-authenticated browser. Conditional on browser credential caching; dynamic proof was not performed."
      }
    }
